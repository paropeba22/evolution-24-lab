// Ingress evidence is never physical writer authority. No cascading Instance FK.
model NexiIngressScope {
  id String @id @db.VarChar(64)
  revision Int @default(0)
  nextSequence BigInt @default(0)
  pending Int @default(0)
  secondaryPending Int @default(0)
}

model NexiIngressLane {
  id String @id @db.VarChar(64)
  scopeId String @db.VarChar(64)
  instanceId String @db.VarChar(100)
  sessionIdentity String @db.VarChar(64)
  pending Int @default(0)
  leaseToken String? @db.VarChar(36)
  leaseUntil DateTime?
  nextAttemptAt DateTime @default(now())
  servedAt DateTime @default(now())
  @@index([instanceId, nextAttemptAt, servedAt])
}

model NexiIngressJournal {
  id String @id @db.VarChar(36)
  dedupKey String @unique @db.VarChar(64)
  scopeId String @db.VarChar(64)
  laneId String @db.VarChar(64)
  instanceId String @db.VarChar(100)
  sessionIdentity String @db.VarChar(64)
  sequence BigInt
  envelope Json JSON_TYPE
  payload String LARGE_TEXT
  state String @default("pending") @db.VarChar(32)
  checkpoint String @default("persisted") @db.VarChar(32)
  association Json? JSON_TYPE
  acknowledgement Json? JSON_TYPE
  controls Json? JSON_TYPE
  attempts Int @default(0)
  lastError String? @db.VarChar(64)
  continuationStartedAt DateTime?
  mainMaterializedAt DateTime?
  payloadPrunedAt DateTime?
  legacyControlKind String? @db.VarChar(32)
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([laneId, sequence])
  @@index([scopeId, state, completedAt])
  @@index([instanceId, state, payloadPrunedAt, completedAt], map: "NexiIngressJournal_retention_idx")
}

// Separate causal lanes: secondary uncertainty never owns the primary lane.
model NexiIngressEffectLane {
  id String @id @db.VarChar(64)
  instanceId String @db.VarChar(100)
  kind String @db.VarChar(32)
  pending Int @default(0)
  leaseToken String? @db.VarChar(36)
  leaseUntil DateTime?
  nextAttemptAt DateTime @default(now())
  servedAt DateTime @default(now())
  blockedBy String? @db.VarChar(36)
  blockedReason String? @db.VarChar(64)
  @@index([instanceId, nextAttemptAt, servedAt])
}

model NexiIngressEffect {
  id String @id @db.VarChar(36)
  journalId String @db.VarChar(36)
  laneId String @db.VarChar(64)
  scopeId String @db.VarChar(64)
  instanceId String @db.VarChar(100)
  kind String @db.VarChar(32)
  sequence BigInt
  intent Json JSON_TYPE
  intentDigest String @db.VarChar(64)
  intentSignature String @db.VarChar(64)
  state String @default("pending") @db.VarChar(32)
  result Json? JSON_TYPE
  attempts Int @default(0)
  lastError String? @db.VarChar(64)
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([journalId, kind])
  @@unique([laneId, sequence])
  @@index([instanceId, state, createdAt])
}
