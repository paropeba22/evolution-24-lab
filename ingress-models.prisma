// Ingress evidence is never physical writer authority. No cascading Instance FK.
model NexiIngressScope {
  id String @id @db.VarChar(64)
  revision Int @default(0)
  nextSequence BigInt @default(0)
  pending Int @default(0)
  secondaryPending Int @default(0)
}

model NexiIngressLane {
  id String @id @db.VarChar(64)
  scopeId String @db.VarChar(64)
  instanceId String @db.VarChar(100)
  sessionIdentity String @db.VarChar(64)
  pending Int @default(0)
  leaseToken String? @db.VarChar(36)
  leaseUntil DateTime?
  nextAttemptAt DateTime @default(now())
  servedAt DateTime @default(now())
  @@index([instanceId, nextAttemptAt, servedAt])
}

model NexiIngressJournal {
  id String @id @db.VarChar(36)
  dedupKey String @unique @db.VarChar(64)
  scopeId String @db.VarChar(64)
  laneId String @db.VarChar(64)
  instanceId String @db.VarChar(100)
  sessionIdentity String @db.VarChar(64)
  sequence BigInt
  envelope Json JSON_TYPE
  payload String LARGE_TEXT
  state String @default("pending") @db.VarChar(32)
  checkpoint String @default("persisted") @db.VarChar(32)
  association Json? JSON_TYPE
  acknowledgement Json? JSON_TYPE
  controls Json? JSON_TYPE
  attempts Int @default(0)
  lastError String? @db.VarChar(64)
  continuationStartedAt DateTime?
  mainMaterializedAt DateTime?
  payloadPrunedAt DateTime?
  legacyControlKind String? @db.VarChar(32)
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([laneId, sequence])
  @@index([scopeId, state, completedAt])
  @@index([instanceId, state, payloadPrunedAt, completedAt], map: "NexiIngressJournal_retention_idx")
}

// Separate causal lanes: secondary uncertainty never owns the primary lane.
model NexiIngressEffectLane {
  id String @id @db.VarChar(64)
  instanceId String @db.VarChar(100)
  kind String @db.VarChar(32)
  pending Int @default(0)
  leaseToken String? @db.VarChar(36)
  leaseUntil DateTime?
  nextAttemptAt DateTime @default(now())
  servedAt DateTime @default(now())
  blockedBy String? @db.VarChar(36)
  blockedReason String? @db.VarChar(64)
  @@index([instanceId, nextAttemptAt, servedAt])
}

model NexiIngressEffect {
  id String @id @db.VarChar(36)
  journalId String @db.VarChar(36)
  laneId String @db.VarChar(64)
  scopeId String @db.VarChar(64)
  instanceId String @db.VarChar(100)
  kind String @db.VarChar(32)
  sequence BigInt
  conversationLaneId String? @db.VarChar(64)
  contractVersion Int @default(1)
  intent Json JSON_TYPE
  intentDigest String @db.VarChar(64)
  intentSignature String @db.VarChar(64)
  state String @default("pending") @db.VarChar(32)
  result Json? JSON_TYPE
  attempts Int @default(0)
  lastError String? @db.VarChar(64)
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([journalId, kind])
  @@unique([laneId, sequence])
  @@index([instanceId, state, createdAt])
  @@index([conversationLaneId, kind, contractVersion, sequence], map: "NexiIngressEffect_causal_idx")
}

// Presentation/lookup cache only; exact authenticated aliases within one scope
// and session. Never the legacy global cache or a physical-send authority.
model NexiIngressContactCache {
  id String @id @db.VarChar(64)
  scopeId String @db.VarChar(64)
  instanceId String @db.VarChar(100)
  sessionIdentity String @db.VarChar(64)
  pnJid String @db.VarChar(64)
  lidJid String? @db.VarChar(64)
  journalId String @db.VarChar(36)
  sequence BigInt
  expiresAt DateTime
  @@unique([scopeId, sessionIdentity, pnJid], map: "NexiIngressContactCache_pn_key")
  @@unique([scopeId, sessionIdentity, lidJid], map: "NexiIngressContactCache_lid_key")
  @@index([instanceId, expiresAt])
}

// Receive ownership metadata only. Historical lanes/journals are never moved.
model NexiIngressOwnerRoot {
  receipt String LARGE_TEXT
  id String @id @db.VarChar(64)
  scopeId String @db.VarChar(64)
  instanceId String @db.VarChar(100)
  sessionIdentity String @db.VarChar(64)
  pnJid String @db.VarChar(64)
  revision Int @default(0)
  activeGenerationId String? @db.VarChar(36)
  sourceFloorSequence BigInt?
}

model NexiIngressOwnerGeneration {
  receipt String LARGE_TEXT
  id String @id @db.VarChar(36)
  candidateId String @unique @db.VarChar(36)
  rootLaneId String @db.VarChar(64)
  oldLaneId String @db.VarChar(64)
  newLaneId String @unique @db.VarChar(64)
  scopeId String @db.VarChar(64)
  instanceId String @db.VarChar(100)
  sessionIdentity String @db.VarChar(64)
  rootRevision Int
  cutoffSequence BigInt
  cutover Json JSON_TYPE
  cutoverDigest String @db.VarChar(64)
  witness Json JSON_TYPE
  snapshot Json JSON_TYPE
  // This unique marker freezes only an installed generation's old lane.
  frozenLaneId String? @unique @db.VarChar(64)
  approval Json? JSON_TYPE
  installedAt DateTime?
  registration Json? JSON_TYPE
  registeredAt DateTime?
  createdAt DateTime @default(now())
  @@index([instanceId, createdAt])
  @@index([rootLaneId, rootRevision])
}

// New raw intake only. A legacy journal is never copied into this table.
model NexiIngressOwnerSource {
  receipt String LARGE_TEXT
  id String @id @db.VarChar(36)
  dedupKey String @unique @db.VarChar(64)
  rootLaneId String @db.VarChar(64)
  scopeId String @db.VarChar(64)
  instanceId String @db.VarChar(100)
  sessionIdentity String @db.VarChar(64)
  sequence BigInt
  envelope Json JSON_TYPE
  payload String LARGE_TEXT
  createdAt DateTime @default(now())
  delivery NexiIngressOwnerDelivery?
  @@unique([rootLaneId, sequence])
  @@index([instanceId, sequence])
}

// One source, one delivery journal, one immutable source/delivery sequence pair.
model NexiIngressOwnerDelivery {
  receipt String LARGE_TEXT
  sourceJournalId String @id @db.VarChar(36)
  deliveryJournalId String @unique @db.VarChar(36)
  generationId String @db.VarChar(36)
  sourceSequence BigInt
  deliverySequence BigInt
  sourceProofDigest String @db.VarChar(64)
  source NexiIngressOwnerSource @relation(fields: [sourceJournalId], references: [id], onDelete: Restrict)
}
